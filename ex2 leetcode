#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* addBinary(char* a, char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    
    // The maximum possible length of the sum is the larger length + 1 (for a final carry)
    int max_len = (len_a > len_b ? len_a : len_b) + 1;
    
    // Allocate memory for the string + 1 extra byte for the null terminator '\0'
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    result[max_len] = '\0'; // Place the null terminator at the very end
    
    int i = len_a - 1; // Pointer for string a
    int j = len_b - 1; // Pointer for string b
    int k = max_len - 1; // Pointer for the result string
    int carry = 0;
    
    // Loop backwards until both strings are exhausted AND there is no remaining carry
    while (i >= 0 || j >= 0 || carry > 0) {
        int sum = carry;
        
        if (i >= 0) {
            sum += a[i] - '0'; // Convert character '0' or '1' to integer 0 or 1
            i--;
        }
        if (j >= 0) {
            sum += b[j] - '0'; // Convert character '0' or '1' to integer 0 or 1
            j--;
        }
        
        carry = sum / 2;             // Calculate the new carry (1 if sum is 2 or 3)
        result[k] = (sum % 2) + '0';   // Store the bit character ('0' or '1')
        k--;
    }
    
    // If the leftmost slot (index 0) was NOT used by a final carry, 
    // shift the entire string left by 1 to remove the leading empty slot
    if (k == 0) {
        memmove(result, result + 1, max_len);
    }
    
    return result;
}



#include <stdbool.h>

bool hasAlternatingBits(int n) {
    // Shift n right by 1 to align opposite bits next to each other
    // Using unsigned long to prevent integer overflow during the addition step
    unsigned long x = n ^ (n >> 1);
    
    // Check if x is of the form 2^k - 1 (all 1s in binary)
    return (x & (x + 1)) == 0;
}

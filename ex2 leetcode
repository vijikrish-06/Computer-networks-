#include <stdlib.h>

// Comparison function for qsort to remove duplicates
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    // Array to store all unique global OR results discovered so far
    int* global_ans = (int*)malloc(arrSize * 32 * sizeof(int));
    int global_size = 0;

    // Buffers to track OR results ending at the previous and current element
    int prev_res[32];
    int prev_size = 0;
    
    int curr_res[32];

    for (int i = 0; i < arrSize; i++) {
        int curr_size = 0;
        
        // 1. Every element forms a subarray of length 1 by itself
        curr_res[curr_size++] = arr[i];
        
        // 2. Compute ORs with all results ending at the previous position
        for (int j = 0; j < prev_size; j++) {
            int or_val = prev_res[j] | arr[i];
            
            // Deduplicate on the fly: only add if it's different from the last added value
            if (or_val != curr_res[curr_size - 1]) {
                curr_res[curr_size++] = or_val;
            }
        }
        
        // 3. Save current results into both the global list and the 'prev' buffer for the next iteration
        for (int j = 0; j < curr_size; j++) {
            global_ans[global_size++] = curr_res[j];
            prev_res[j] = curr_res[j];
        }
        prev_size = curr_size;
    }

    // 4. Sort the global results array to group duplicates together
    qsort(global_ans, global_size, sizeof(int), compare);

    // 5. Count the unique entries in the sorted global array
    if (global_size == 0) {
        free(global_ans);
        return 0;
    }
    
    int unique_count = 1;
    for (int i = 1; i < global_size; i++) {
        if (global_ans[i] != global_ans[i - 1]) {
            unique_count++;
        }
    }

    free(global_ans);
    return unique_count;
}

#include <stdio.h>
#include <string.h>

int main() {
    char inputString[100];
    char rawGenInput[100];
    char gen[64] = "";
    char rawBinaryData[1000] = "";
    char paddedData[1000] = "";
    char remainder[64] = "";
    char transmittedCodeword[1000] = "";
    char receivedCodeword[1000] = "";

    printf("==================================================\n");
    printf("      CYCLIC REDUNDANCY CHECK (CRC) SYSTEM        \n");
    printf("==================================================\n");

    printf("\nEnter input data string (e.g., Hello, b, 5): ");
    fgets(inputString, sizeof(inputString), stdin);
    inputString[strcspn(inputString, "\n")] = '\0';

    printf("Enter CRC Generator (Binary '11011' or Expression 'x^4 + x^3 + x + 1'): ");
    fgets(rawGenInput, sizeof(rawGenInput), stdin);
    rawGenInput[strcspn(rawGenInput, "\n")] = '\0';

    /* ================= 1. PARSE GENERATOR INPUT ================= */
    int isBinary = 1;
    for (int i = 0; rawGenInput[i] != '\0'; i++) {
        if (rawGenInput[i] != '0' && rawGenInput[i] != '1' && rawGenInput[i] != ' ') {
            isBinary = 0;
            break;
        }
    }

    if (isBinary) {
        int idx = 0;
        for (int i = 0; rawGenInput[i] != '\0'; i++) {
            if (rawGenInput[i] == '0' || rawGenInput[i] == '1') {
                gen[idx++] = rawGenInput[i];
            }
        }
        gen[idx] = '\0';
    } else {
        // Simple manual parser for polynomial expressions
        int degrees[32] = {0};
        int maxDegree = 0;

        for (int i = 0; rawGenInput[i] != '\0'; i++) {
            if (rawGenInput[i] == 'x') {
                if (rawGenInput[i + 1] == '^') {
                    int deg = rawGenInput[i + 2] - '0';
                    degrees[deg] = 1;
                    if (deg > maxDegree) maxDegree = deg;
                } else {
                    degrees[1] = 1;
                    if (1 > maxDegree) maxDegree = 1;
                }
            } else if (rawGenInput[i] == '1' && (i == 0 || rawGenInput[i - 1] != '^')) {
                degrees[0] = 1;
            }
        }

        int idx = 0;
        for (int i = maxDegree; i >= 0; i--) {
            gen[idx++] = degrees[i] ? '1' : '0';
        }
        gen[idx] = '\0';
    }

    int genLen = strlen(gen);
    int degree = genLen - 1;

    /* ================= 2. GENERATOR VALIDATION ================= */
    printf("\n---- GENERATOR PARSING & VALIDATION ----\n");
    printf("Parsed Binary Generator   : %s  (Degree = %d)\n", gen, degree);

    int r1_start = (gen[0] == '1');
    int r1_end = (gen[genLen - 1] == '1');

    int onesCount = 0;
    for (int i = 0; i < genLen; i++) {
        if (gen[i] == '1') onesCount++;
    }
    int r2_even = (onesCount % 2 == 0);

    if (r1_start && r1_end) {
        printf(" [PASS] Rule 1: Starts and ends with '1'.\n");
    } else {
        if (!r1_start) printf(" [FAIL] Rule 1: Must start with '1'.\n");
        if (!r1_end)   printf(" [FAIL] Rule 1: Must end with '1' (x^0 coefficient must be 1).\n");
    }

    if (r2_even) {
        printf(" [PASS] Rule 2: Contains an even count of '1's (%d ones -> x+1 factor present).\n", onesCount);
    } else {
        printf(" [FAIL] Rule 2: Must have an even count of '1's (factor of x+1).\n");
    }

    if (!r1_start || !r1_end || !r2_even) {
        printf("\nRESULT: INVALID GENERATOR! Generator does not satisfy CRC rules.\n");
        return 0; // Stop execution if generator fails validation
    }
    printf("\nRESULT: GENERATOR VALIDATED SUCCESSFULLY!\n");

    /* ================= 3. SENDER SIDE ================= */
    printf("\n---- SENDER'S SIDE ----\n");
    printf("Input Data String         : %s\n", inputString);

    // Convert string to 7-bit binary representation
    int strLen = strlen(inputString);
    int rawIdx = 0;
    for (int i = 0; i < strLen; i++) {
        int temp = (int)inputString[i] & 0x7F;
        for (int j = 6; j >= 0; j--) {
            rawBinaryData[rawIdx + j] = (temp % 2) + '0';
            temp /= 2;
        }
        rawIdx += 7;
    }
    rawBinaryData[rawIdx] = '\0';
    printf("7-Bit Raw Binary Data     : %s\n", rawBinaryData);

    // Pad data with 'degree' zeros
    strcpy(paddedData, rawBinaryData);
    for (int i = 0; i < degree; i++) {
        strcat(paddedData, "0");
    }
    printf("Padded Data Stream        : %s  (%d zeros padded)\n", paddedData, degree);

    // Modulo-2 Division on Sender Side
    char tempDiv[1000];
    strcpy(tempDiv, paddedData);
    int paddedLen = strlen(paddedData);

    for (int i = 0; i <= paddedLen - genLen; i++) {
        if (tempDiv[i] == '1') {
            for (int j = 0; j < genLen; j++) {
                tempDiv[i + j] = (tempDiv[i + j] == gen[j]) ? '0' : '1';
            }
        }
    }

    // Extract CRC Remainder
    for (int i = 0; i < degree; i++) {
        remainder[i] = tempDiv[paddedLen - degree + i];
    }
    remainder[degree] = '\0';
    printf("Calculated CRC Remainder  : %s\n", remainder);

    // Form Transmitted Codeword
    strcpy(transmittedCodeword, rawBinaryData);
    strcat(transmittedCodeword, remainder);
    printf("Transmitted Codeword      : %s\n", transmittedCodeword);

    /* ================= 4. ERROR INDUCTION ================= */
    strcpy(receivedCodeword, transmittedCodeword);
    int totalCodewordLen = strlen(receivedCodeword);

    printf("\n---- ERROR INDUCTION ----\n");
    printf("Select Error Type:\n");
    printf("0. No Error\n");
    printf("1. Single-Bit Error\n");
    printf("2. Multi-Bit / Burst Error\n");
    printf("Enter choice: ");

    int errorType;
    scanf("%d", &errorType);

    if (errorType == 1) {
        int bitPos;
        printf("Enter bit position to flip (0 to %d): ", totalCodewordLen - 1);
        scanf("%d", &bitPos);

        if (bitPos >= 0 && bitPos < totalCodewordLen) {
            receivedCodeword[bitPos] = (receivedCodeword[bitPos] == '0') ? '1' : '0';
            printf("  -> Flipped Bit %d.\n", bitPos);
        }
    } 
    else if (errorType == 2) {
        int totalFlips;
        printf("How many bits to flip?: ");
        scanf("%d", &totalFlips);

        for (int flip = 1; flip <= totalFlips; flip++) {
            int bitPos;
            printf("[Flip %d] Enter bit position to flip (0 to %d): ", flip, totalCodewordLen - 1);
            scanf("%d", &bitPos);

            if (bitPos >= 0 && bitPos < totalCodewordLen) {
                receivedCodeword[bitPos] = (receivedCodeword[bitPos] == '0') ? '1' : '0';
                printf("  -> Flipped Bit %d.\n", bitPos);
            }
        }
    }

    /* ================= 5. RECEIVER SIDE ================= */
    printf("\n---- RECEIVER'S SIDE ----\n");
    printf("Received Codeword         : %s\n", receivedCodeword);

    // Modulo-2 Division on Receiver Side
    strcpy(tempDiv, receivedCodeword);
    for (int i = 0; i <= totalCodewordLen - genLen; i++) {
        if (tempDiv[i] == '1') {
            for (int j = 0; j < genLen; j++) {
                tempDiv[i + j] = (tempDiv[i + j] == gen[j]) ? '0' : '1';
            }
        }
    }

    char recRemainder[64];
    for (int i = 0; i < degree; i++) {
        recRemainder[i] = tempDiv[totalCodewordLen - degree + i];
    }
    recRemainder[degree] = '\0';

    printf("Calculated Remainder      : %s", recRemainder);

    int hasError = 0;
    for (int i = 0; i < degree; i++) {
        if (recRemainder[i] != '0') {
            hasError = 1;
            break;
        }
    }

    if (hasError) {
        printf("  (Non-Zero!)\n");
    } else {
        printf("  (Zero!)\n");
    }

    /* ================= 6. TRANSMISSION RESULT ================= */
    printf("\n---- TRANSMISSION RESULT ----\n");
    if (hasError) {
        printf("Result                    : ERROR DETECTED! Remainder != 0. Frame discarded.\n");
    } else {
        printf("Result                    : NO ERROR DETECTED.\n");

        // Reconstruct original text from received bits
        char extractedString[100] = "";
        int rawLen = strlen(rawBinaryData);

        for (int i = 0; i < rawLen; i += 7) {
            int asciiVal = 0;
            for (int j = 0; j < 7; j++) {
                asciiVal = (asciiVal * 2) + (receivedCodeword[i + j] - '0');
            }
            extractedString[i / 7] = (char)asciiVal;
        }
        extractedString[rawLen / 7] = '\0';

        printf("Extracted Data            : %s\n", extractedString);
    }

    return 0;
}


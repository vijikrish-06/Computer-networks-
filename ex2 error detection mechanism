#include <stdio.h>
#include <string.h>

int main() {
    char inputString[100];
    int choice, length;

    int rawDataBits[100][7];
    int frames[100][8];
    char finalOutput[100];

    printf("==================================================\n");
    printf("   1D PARITY STRING TRANSMISSION SYSTEM (8-BIT)   \n");
    printf("==================================================\n");

    printf("\nEnter input string: ");
    fgets(inputString, sizeof(inputString), stdin);
    inputString[strcspn(inputString, "\n")] = '\0';
    length = strlen(inputString);

    printf("Choose Parity (1. Even Parity / 2. Odd Parity): ");
    scanf("%d", &choice);

    /* ================= SENDER SIDE ================= */
    printf("\n---- SENDER'S SIDE ----\n");
    printf("Input Data String        : %s\n", inputString);

    // Convert string to 7-bit ASCII
    for (int i = 0; i < length; i++) {
        int temp = (int)inputString[i] & 0x7F;
        for (int j = 6; j >= 0; j--) {
            rawDataBits[i][j] = temp % 2;
            temp /= 2;
        }
    }

    printf("7-Bit Raw Binary Data    : ");
    for (int i = 0; i < length; i++) {
        for (int j = 0; j < 7; j++) {
            printf("%d", rawDataBits[i][j]);
        }
        printf("  ");
    }
    printf("\n");

    // Generate parity for each 7-bit block to build 8-bit frames
    for (int i = 0; i < length; i++) {
        int onesCount = 0;
        for (int j = 0; j < 7; j++) {
            frames[i][j] = rawDataBits[i][j];
            if (frames[i][j] == 1) onesCount++;
        }
        frames[i][7] = (choice == 1) ? (onesCount % 2 != 0) : (onesCount % 2 == 0);
    }

    printf("Transmitted Codewords    : ");
    for (int i = 0; i < length; i++) {
        for (int j = 0; j < 8; j++) {
            printf("%d", frames[i][j]);
        }
        printf("  ");
    }
    printf("\n");

    /* ================= ERROR INDUCTION ================= */
    printf("\n---- ERROR INDUCTION ----\n");
    printf("Select Error Type:\n0. No Error\n1. Single-Bit Error\n2. Multi-Bit / Burst Error\nEnter choice: ");

    int errorType;
    scanf("%d", &errorType);

    if (errorType == 1) {
        int targetBlock, targetBit;
        printf("Enter Block Number (1 to %d): ", length);
        scanf("%d", &targetBlock);
        printf("Enter Bit Position to Flip (0 to 7): ");
        scanf("%d", &targetBit);

        if (targetBlock >= 1 && targetBlock <= length && targetBit >= 0 && targetBit <= 7) {
            frames[targetBlock - 1][targetBit] ^= 1;
            printf("  -> Flipped Bit %d in Block %d.\n", targetBit, targetBlock);
        }
    } 
    else if (errorType == 2) {
        int totalFlips;
        printf("How many bits to flip?: ");
        scanf("%d", &totalFlips);

        for (int flip = 1; flip <= totalFlips; flip++) {
            int targetBlock, targetBit;
            printf("[Flip %d] Enter Block Number (1-%d) & Bit Position (0-7): ", flip, length);
            scanf("%d %d", &targetBlock, &targetBit);

            if (targetBlock >= 1 && targetBlock <= length && targetBit >= 0 && targetBit <= 7) {
                frames[targetBlock - 1][targetBit] ^= 1;
                printf("  -> Flipped Bit %d in Block %d.\n", targetBit, targetBlock);
            }
        }
    }

    /* ================= RECEIVER SIDE (GLOBAL COMBINED CHECK) ================= */
    printf("\n---- RECEIVER'S SIDE ----\n");
    printf("Received Codewords       : ");
    
    int globalOnesCount = 0;
    for (int i = 0; i < length; i++) {
        int asciiRecovered = 0;
        for (int j = 0; j < 8; j++) {
            printf("%d", frames[i][j]);
            if (frames[i][j] == 1) globalOnesCount++;
            if (j < 7) {
                asciiRecovered = (asciiRecovered << 1) | frames[i][j];
            }
        }
        finalOutput[i] = (char)asciiRecovered;
        printf("  ");
    }
    printf("\n");

    // Global combined parity verification
    int isParityValid = 0;
    if (choice == 1) // Even Parity: Total 1s in combined stream must be even
        isParityValid = (globalOnesCount % 2 == 0);
    else             // Odd Parity: Total 1s in combined stream must be odd
        isParityValid = (globalOnesCount % 2 != 0);

    finalOutput[length] = '\0';

    /* ================= TRANSMISSION RESULT ================= */
    printf("\n---- TRANSMISSION RESULT ----\n");
    if (!isParityValid) {
        printf("Result         : ERROR DETECTED! Stream discarded due to parity violation.\n");
    } else {
        printf("Result         : NO ERROR DETECTED.\n");
        printf("Extracted Data : %s\n", finalOutput);
    }

    return 0;
}

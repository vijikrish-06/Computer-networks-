#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

#define INF 999999

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    // 1-indexed distance array initialization
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    bool* visited = (bool*)calloc((n + 1), sizeof(bool));
    
    // Create and fill adjacency matrix with infinity
    int** graph = (int**)malloc((n + 1) * sizeof(int*));
    for (int i = 0; i <= n; i++) {
        graph[i] = (int*)malloc((n + 1) * sizeof(int));
        for (int j = 0; j <= n; j++) {
            graph[i][j] = (i == j) ? 0 : INF;
        }
    }
    
    // Populate the adjacency matrix with actual times
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        graph[u][v] = w;
    }
    
    // Initialize distance array from starting node k
    for (int i = 1; i <= n; i++) {
        dist[i] = graph[k][i];
    }
    dist[k] = 0;
    visited[k] = true;
    
    // Dijkstra's main relaxation loop
    for (int count = 1; count < n; count++) {
        int u = -1;
        int minDist = INF;
        
        // Step 1: Find the unvisited node with the smallest distance
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < minDist) {
                minDist = dist[i];
                u = i;
            }
        }
        
        // If no more reachable nodes are found, break early
        if (u == -1) break;
        
        visited[u] = true;
        
        // Step 2: Update (relax) neighbors of the selected node u
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && graph[u][v] != INF && dist[u] + graph[u][v] < dist[v]) {
                dist[v] = dist[u] + graph[u][v];
            }
        }
    }
    
    // Step 3: Find the maximum time taken among all nodes
    int maxTime = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            // A node is completely unreachable, so all nodes cannot receive the signal
            maxTime = -1;
            break;
        }
        if (dist[i] > maxTime) {
            maxTime = dist[i];
        }
    }
    
    // Free allocated memory
    for (int i = 0; i <= n; i++) free(graph[i]);
    free(graph);
    free(dist);
    free(visited);
    
    return maxTime;
}

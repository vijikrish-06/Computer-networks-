#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

// Node structure for the adjacency list
typedef struct Edge {
    int to;
    int is_original; // 1 if direction is u -> v, 0 if v -> u
    struct Edge* next;
} Edge;

// Helper function to insert an edge into the adjacency list
void addEdge(Edge** adj, int from, int to, int is_original) {
    Edge* e = (Edge*)malloc(sizeof(Edge));
    e->to = to;
    e->is_original = is_original;
    e->next = adj[from];
    adj[from] = e;
}

// Standard DFS traversal moving outwards from city 0
void dfs(int node, int parent, Edge** adj, int* changeCount) {
    Edge* e = adj[node];
    while (e != NULL) {
        if (e->to != parent) {
            // If the road points away from the capital, it must be reversed
            if (e->is_original == 1) {
                (*changeCount)++;
            }
            dfs(e->to, node, adj, changeCount);
        }
        e = e->next;
    }
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    // Allocate adjacency list dynamically
    Edge** adj = (Edge**)calloc(n, sizeof(Edge*));
    
    // Build the bi-directional tree graph
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        
        addEdge(adj, u, v, 1); // Original road orientation
        addEdge(adj, v, u, 0); // Simulated reverse orientation
    }
    
    int changeCount = 0;
    
    // Start DFS from the capital (node 0) with a dummy parent (-1)
    dfs(0, -1, adj, &changeCount);
    
    // Clean up allocated memory
    for (int i = 0; i < n; i++) {
        Edge* e = adj[i];
        while (e != NULL) {
            Edge* tmp = e;
            e = e->next;
            free(tmp);
        }
    }
    free(adj);
    
    return changeCount;
}


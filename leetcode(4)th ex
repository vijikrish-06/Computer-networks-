#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define MAX_STOPS 1000000

// Structure to hold a dynamic array of bus IDs for each stop
typedef struct {
    int *buses;
    int size;
    int capacity;
} BusList;

int numBusesToDestination(int** routes, int routesSize, int* routesColSize, int source, int target) {
    // If source and target are the same, 0 buses are needed
    if (source == target) return 0;

    // Allocate memory for stop-to-bus mapping dynamically to avoid massive stack sizes
    BusList* stopToBuses = (BusList*)calloc(MAX_STOPS, sizeof(BusList));

    // Populate the stop-to-bus mapping
    for (int busId = 0; busId < routesSize; busId++) {
        for (int j = 0; j < routesColSize[busId]; j++) {
            int stop = routes[busId][j];
            
            if (stopToBuses[stop].size == stopToBuses[stop].capacity) {
                stopToBuses[stop].capacity = stopToBuses[stop].capacity == 0 ? 4 : stopToBuses[stop].capacity * 2;
                stopToBuses[stop].buses = (int*)realloc(stopToBuses[stop].buses, stopToBuses[stop].capacity * sizeof(int));
            }
            stopToBuses[stop].buses[stopToBuses[stop].size++] = busId;
        }
    }

    // BFS Queue Setup
    // Maximum possible elements in the queue will not exceed total stops across all routes
    int totalStopsCount = 0;
    for (int i = 0; i < routesSize; i++) totalStopsCount += routesColSize[i];
    
    int* queue = (int*)malloc((totalStopsCount + 1) * sizeof(int));
    int head = 0, tail = 0;

    // Tracking arrays
    bool* visitedStops = (bool*)calloc(MAX_STOPS, sizeof(bool));
    bool* visitedBuses = (bool*)calloc(routesSize, sizeof(bool));

    // Enqueue source
    queue[tail++] = source;
    visitedStops[source] = true;

    int busCount = 0;

    // Standard BFS Loop
    while (head < tail) {
        int levelSize = tail - head;
        busCount++; // Increment bus boarding tier for this level

        for (int i = 0; i < levelSize; i++) {
            int currentStop = queue[head++];

            // Explore all buses that pass through the current stop
            int availableBusesCount = stopToBuses[currentStop].size;
            for (int j = 0; j < availableBusesCount; j++) {
                int busId = stopToBuses[currentStop].buses[j];

                if (visitedBuses[busId]) continue;
                visitedBuses[busId] = true;

                // Explore all stops reachable by this bus route
                for (int k = 0; k < routesColSize[busId]; k++) {
                    int nextStop = routes[busId][k];

                    if (visitedStops[nextStop]) continue;

                    // Destination found!
                    if (nextStop == target) {
                        // Free all dynamically allocated memory before returning
                        for (int m = 0; m < MAX_STOPS; m++) {
                            if (stopToBuses[m].buses) free(stopToBuses[m].buses);
                        }
                        free(stopToBuses);
                        free(queue);
                        free(visitedStops);
                        free(visitedBuses);
                        return busCount;
                    }

                    visitedStops[nextStop] = true;
                    queue[tail++] = nextStop;
                }
            }
        }
    }

    // Free memory if target is unreachable
    for (int m = 0; m < MAX_STOPS; m++) {
        if (stopToBuses[m].buses) free(stopToBuses[m].buses);
    }
    free(stopToBuses);
    free(queue);
    free(visitedStops);
    free(visitedBuses);

    return -1; // Target unreachable
}

//Complete the following function.


void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;
    
    // Check all combinations of pairs (a, b) such that 1 <= a < b <= n
    for (int a = 1; a < n; a++) {
        for (int b = a + 1; b <= n; b++) {
            int current_and = a & b;
            int current_or  = a | b;
            int current_xor = a ^ b;
            
            // Update AND max if the value is less than k
            if (current_and < k && current_and > max_and) {
                max_and = current_and;
            }
            
            // Update OR max if the value is less than k
            if (current_or < k && current_or > max_or) {
                max_or = current_or;
            }
            
            // Update XOR max if the value is less than k
            if (current_xor < k && current_xor > max_xor) {
                max_xor = current_xor;
            }
        }
    }
    
    // Print each result on a new line as required
    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}


